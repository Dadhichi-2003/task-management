{
   "compilerOptions": {
     "module": "ES2022",
     "target": "ES2020",
     "moduleResolution": "bundler",  
     "esModuleInterop": true,
     "allowImportingTsExtensions": true, 
     "resolveJsonModule": true,
     "skipLibCheck": true,
     "strict": true,
     "noEmit": true  
   },
   "ts-node": {
     "esm": true
   }
 }
 